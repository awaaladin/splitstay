# Copy to .env for local runs outside Docker. docker-compose has safe defaults and needs no .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://splitstay:splitstay@localhost:5432/splitstay
REDIS_URL=redis://localhost:6379/0

# Fernet key used to encrypt bank account numbers at rest. REQUIRED in production.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Payment collection + transfers: "mock" (offline sandbox) or "paystack".
PAYMENT_GATEWAY=mock
PAYSTACK_SECRET_KEY=

# Bill payments: "mock" or "vtpass".
BILL_PROVIDER=mock
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

# Service fee taken at payout: flat (naira) or percent.
SERVICE_FEE_TYPE=flat
SERVICE_FEE_FLAT=150
SERVICE_FEE_PERCENT=1.5
SERVICE_FEE_MIN=0
SERVICE_FEE_MAX=0

THROTTLE_AUTH=10/min
THROTTLE_GROUP_CREATE=20/hour
